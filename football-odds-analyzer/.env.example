# Copier ce fichier en .env puis renseigner la clé
API_FOOTBALL_KEY=votre_cle_api_sports_io

# Source des cotes : pinnacle (repli : moyenne des bookmakers) | average | listing (meilleure cote de la liste)
ODDS_SOURCE=pinnacle
# Fenêtre d'extraction : J à J+DAYS_AHEAD
DAYS_AHEAD=3
# Seuils (aussi modifiables dans l'interface)
FAVORITE_MAX_ODDS=1.70
OUTSIDER_MIN_ODDS=4.00
MAX_LEAGUE_TIER=2

# Scraping
SCRAPE_DELAY_MIN=3
SCRAPE_DELAY_MAX=8
SCRAPE_CACHE_TTL_MIN=90
SCRAPE_MAX_MATCH_PAGES=200
SCRAPE_HEADLESS=true
# Chemin d'un Chromium déjà installé (facultatif)
# CHROMIUM_EXECUTABLE=/usr/bin/chromium

# Planification / analyse
REFRESH_INTERVAL_HOURS=2
SCHEDULER_ENABLED=true
ANALYZE_AFTER_SCRAPE=true
API_CACHE_TTL_HOURS=12
TEAM_MATCH_MIN_SCORE=85

TIMEZONE=America/Toronto
# DATA_DIR=./data
